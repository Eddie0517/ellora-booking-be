# ==============================================================================
# Ellora Booking Backend — production environment (example)
# ==============================================================================
# This file is a KEY CONTRACT, not a working configuration.
#
#   - Never commit a real .env.production.
#   - On the VPS the real file lives at /opt/ellora/.env.production, mode 600,
#     owner deploy. CD never overwrites it; it only validates the key set.
#   - Validate with: sh deployments/scripts/verify-env.sh .env.production
#
# Conventions:
#   - One KEY=value per line, no `export`, no inline comments after a value.
#   - Values with spaces must be double-quoted, e.g. MAIL_FROM_NAME="Ellora Booking".
#   - Use URL-safe alphanumeric passwords (A-Z a-z 0-9 - _) to avoid escaping
#     issues in shell scripts and database URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Internal container port. Never published to the host (Cloudflare Tunnel).
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ELLORA=INFO

# ------------------------------------------------------------------------------
# 2. PostgreSQL 17 (container `postgres`, internal network only)
# ------------------------------------------------------------------------------
POSTGRES_DB=ellora
POSTGRES_USER=ellora
# REQUIRED: long random value, no quotes.
POSTGRES_PASSWORD=
# Optional memory limits (compose defaults are fine for a 3.8 GiB shared VPS).
# POSTGRES_MEM_LIMIT=384m

# ------------------------------------------------------------------------------
# 3. Redis 7 (container `redis`, internal network only)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_MAXMEMORY=192mb

# ------------------------------------------------------------------------------
# 4. Mail — Google SMTP
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Google account address
MAIL_USERNAME=
# Google App Password (16 characters, https://myaccount.google.com/apppasswords)
MAIL_PASSWORD=
MAIL_FROM=no-reply@ellora.vn
MAIL_FROM_NAME="Ellora Booking"

# ------------------------------------------------------------------------------
# 5. JWT (HS256)
# ------------------------------------------------------------------------------
# REQUIRED: base64 secret of at least 32 random bytes.
# Generate: bash scripts/jwt-keys.sh
# Rotating this value invalidates every issued token (all users must log in).
JWT_SECRET=
JWT_ISSUER=ellora-booking-be
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# ------------------------------------------------------------------------------
# 6. Cloudinary (media storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 7. PayOS (subscription billing)
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
# Public frontend URLs used after payment / cancellation.
PAYOS_RETURN_URL=https://ellorabooking.online/owner/subscription
PAYOS_CANCEL_URL=https://ellorabooking.online/owner/subscription
# Register this webhook URL in the PayOS dashboard:
#   https://api.ellorabooking.online/api/v1/webhooks/payos

# ------------------------------------------------------------------------------
# 8. Google OAuth 2.0
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 9. CORS
# ------------------------------------------------------------------------------
# Comma-separated exact origins. No wildcard, no trailing slash.
CORS_ALLOWED_ORIGINS=https://ellorabooking.online,https://www.ellorabooking.online

# ------------------------------------------------------------------------------
# 10. Cloudflare Tunnel
# ------------------------------------------------------------------------------
# REQUIRED: token of the tunnel routed to api.ellorabooking.online.
# Create in Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 11. Container resource limits (optional overrides)
# ------------------------------------------------------------------------------
# API_MEM_LIMIT=768m
# REDIS_MEM_LIMIT=128m
