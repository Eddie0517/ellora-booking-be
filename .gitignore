# ---- Spec Kit local state ----
# Per-machine developer handle used to name specs/<owner>-<NNN>-<slug>.
# Each developer fills their own; it must never be committed.
.specify/owner.json

# ---- Environment Secrets & Local Overrides ----
# Never commit actual secret files
.env
.env.local
.env.*.local
!.env.example

# ---- Cryptographic Keys & Certificates ----
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
*.jks

# ---- Build & Maven Artifacts ----
target/
*.jar
*.war
*.ear
*.class
.mvn/wrapper/maven-wrapper.jar

# ---- IDE & Editor Configuration ----
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.settings/
.project
.classpath
.factorypath
bin/

# ---- Logs & Crash Dumps ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
hs_err_pid*
replay_pid*

# ---- Test & Coverage Reports ----
coverage/
.nyc_output/
jacoco.exec
*.exec

# ---- Operating System Files ----
.DS_Store
Thumbs.db
Desktop.ini
*.orig
*.rej

# ---- Node & Agent Safety Net ----
node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
