{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Ellora Nail Salon Booking API",
    "description" : "API Documentation for Ellora Nail Salon Management and Booking System",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Local Containerized Environment"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "System",
    "description" : "System liveness and diagnostics endpoints"
  }, {
    "name" : "Bookings",
    "description" : "Endpoints for scheduling appointments, retrieving booking details, and updating status"
  }, {
    "name" : "Authentication",
    "description" : "Endpoints for user registration, OTP email verification, authentication and token refresh"
  }, {
    "name" : "Profile",
    "description" : "User profile compatibility endpoints"
  }, {
    "name" : "Salons",
    "description" : "Endpoints for discovering salons, viewing service menus and staff members"
  } ],
  "paths" : {
    "/api/v1/bookings/{id}/status" : {
      "put" : {
        "tags" : [ "Bookings" ],
        "summary" : "Update booking status",
        "description" : "Transitions booking status (CONFIRMED, COMPLETED, CANCELLED, DISPUTED)",
        "operationId" : "updateBookingStatus",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TransitionStatusRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/salons" : {
      "get" : {
        "tags" : [ "Salons" ],
        "summary" : "Search and list salons",
        "description" : "Returns paginated list of active nail salons matching city and keyword filters",
        "operationId" : "getSalons",
        "parameters" : [ {
          "name" : "city",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "keyword",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 1
          }
        }, {
          "name" : "pageSize",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PagedResultSalonSummaryResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Salons" ],
        "summary" : "Register new salon",
        "description" : "Enables salon owners to register a new salon profile pending approval",
        "operationId" : "createSalon",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateSalonRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SalonDetailsResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/bookings" : {
      "post" : {
        "tags" : [ "Bookings" ],
        "summary" : "Create an appointment booking",
        "description" : "Creates a booking for an authenticated user or a guest (walk-in) customer",
        "operationId" : "createBooking",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateBookingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Verify email with OTP",
        "description" : "Verifies customer email with 6-digit OTP code and returns initial JWT credentials",
        "operationId" : "verifyEmail",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/resend-verification" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Resend email verification OTP",
        "description" : "Generates and sends a new 6-digit OTP code to the user's email",
        "operationId" : "resendVerification",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResendVerificationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Customer registration",
        "description" : "Registers a new customer account and sends 6-digit OTP verification email",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegisterResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Refresh token rotation",
        "description" : "Rotates refresh token and issues a new access token",
        "operationId" : "refresh",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "User logout",
        "description" : "Revokes refresh tokens and blacklists the current access token",
        "operationId" : "logout",
        "parameters" : [ {
          "name" : "Authorization",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "User login",
        "description" : "Authenticates credentials and returns access & refresh tokens (requires verified email)",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/change-password" : {
      "post" : {
        "tags" : [ "Authentication" ],
        "summary" : "Change password",
        "description" : "Changes password for authenticated user and revokes active sessions",
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/healthz" : {
      "get" : {
        "tags" : [ "System" ],
        "summary" : "Liveness check",
        "description" : "Returns system liveness status and current UTC timestamp",
        "operationId" : "healthz",
        "responses" : {
          "200" : {
            "description" : "System is healthy",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/salons/{id}" : {
      "get" : {
        "tags" : [ "Salons" ],
        "summary" : "Get salon details",
        "description" : "Returns full profile, address, and ratings for a specific salon",
        "operationId" : "getSalonDetails",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SalonDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/salons/{id}/staff" : {
      "get" : {
        "tags" : [ "Salons" ],
        "summary" : "Get salon staff",
        "description" : "Returns active staff members working at the specified salon",
        "operationId" : "getSalonStaff",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/EmployeeResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/salons/{id}/services" : {
      "get" : {
        "tags" : [ "Salons" ],
        "summary" : "Get salon services",
        "description" : "Returns service menu and pricing for the specified salon",
        "operationId" : "getSalonServices",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NailServiceResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookings/{id}" : {
      "get" : {
        "tags" : [ "Bookings" ],
        "summary" : "Get booking details by ID",
        "description" : "Retrieves complete booking details and scheduling status",
        "operationId" : "getBookingDetails",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "tags" : [ "Authentication" ],
        "summary" : "Get current user profile",
        "description" : "Returns profile details of the authenticated user",
        "operationId" : "getCurrentUser",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserProfileResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/profiles/me" : {
      "get" : {
        "tags" : [ "Profile" ],
        "summary" : "Get current user profile (legacy compatibility)",
        "description" : "Compatibility route for frontend GET /api/profiles/me",
        "operationId" : "getCurrentProfile",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserProfileResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    }
  },
