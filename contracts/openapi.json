        "required" : [ "status" ],
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "cancellationReason" : {
            "type" : "string"
          },
          "note" : {
            "type" : "string"
          }
        }
      },
      "BookingDetailsResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "customerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "walkInName" : {
            "type" : "string"
          },
          "guestEmail" : {
            "type" : "string"
          },
          "walkInPhone" : {
            "type" : "string"
          },
          "salonId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "serviceId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "employeeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "scheduledAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "durationMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "servicePriceSnapshot" : {
            "type" : "number"
          },
          "status" : {
            "type" : "string"
          },
          "customerNote" : {
            "type" : "string"
          },
          "salonNote" : {
            "type" : "string"
          },
          "cancellationReason" : {
            "type" : "string"
          },
          "completedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "CreateSalonRequest" : {
        "required" : [ "address", "name" ],
        "type" : "object",
        "properties" : {
          "name" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "address" : {
            "type" : "string"
          },
          "city" : {
            "type" : "string"
          },
          "district" : {
            "type" : "string"
          },
          "phone" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          }
        }
      },
      "SalonDetailsResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
