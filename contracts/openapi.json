{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Ellora Nail Salon Booking API",
    "description" : "API Documentation for Ellora Nail Salon Management and Booking System",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Local Containerized Environment"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "System",
    "description" : "System liveness and diagnostics endpoints"
  } ],
  "paths" : {
    "/healthz" : {
      "get" : {
        "tags" : [ "System" ],
        "summary" : "Liveness check",
        "description" : "Returns system liveness status and current UTC timestamp",
        "operationId" : "healthz",
        "responses" : {
          "200" : {
            "description" : "System is healthy",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "HealthStatus" : {
        "required" : [ "status", "timestamp" ],
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "example" : "UP"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "description" : "System liveness health status"
      },
      "InvalidParam" : {
        "required" : [ "name", "reason" ],
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "example" : "email"
          },
          "reason" : {
            "type" : "string",
            "example" : "Email không đúng định dạng RFC 5322"
          }
        }
      },
      "ProblemDetail" : {
        "required" : [ "type", "title", "status" ],
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri",
            "example" : "https://ellora.vn/errors/auth.invalid_credentials"
          },
          "title" : {
            "type" : "string",
            "example" : "Thông tin xác thực không hợp lệ"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 401
          },
          "detail" : {
            "type" : "string",
            "example" : "Email hoặc mật khẩu không chính xác."
          },
          "instance" : {
            "type" : "string",
            "example" : "/api/auth/login"
          },
          "traceId" : {
            "type" : "string",
            "example" : "c2b5e297-88eb-4209-906d-e4ebc52119c8"
          },
          "invalidParams" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/InvalidParam"
            }
          }
        },
        "description" : "RFC 9457 Problem Details schema"
      },
      "PagedResult" : {
        "required" : [ "items", "page", "pageSize", "totalItems", "totalPages" ],
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "type" : "object"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 1
          },
          "pageSize" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 20
          },
          "totalItems" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 120
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 6
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "description" : "ES256 signed JWT Bearer Token",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
