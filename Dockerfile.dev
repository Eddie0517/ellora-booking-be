# ==============================================================================
# Development image — Ellora Booking Backend
#
# Keeps the zero-host-Java workflow promised by AGENTS.md: Maven, the JDK and
# the project sources are inside the image so `docker compose run --rm backend
# mvn ...` works on any machine.
#
# Production uses ./Dockerfile instead (JRE only, JAR only).
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & verification stage
# ------------------------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-17-alpine AS build
WORKDIR /build

# Copy project descriptor and all module sources
COPY pom.xml ./
COPY . ./

# Build deployable fat JAR if ellora-api submodule is present
RUN --mount=type=cache,target=/root/.m2 if [ -f "ellora-api/pom.xml" ]; then \
        mvn -q clean package -DskipTests; \
    else \
        mkdir -p ellora-api/target && \
        touch ellora-api/target/ellora-api-placeholder.jar; \
    fi

# ------------------------------------------------------------------------------
# Stage 2: Developer runtime stage (Maven + JDK available on purpose)
# ------------------------------------------------------------------------------
FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app

RUN addgroup -S ellora && adduser -S ellora -G ellora

# Containerized CLI workflows: docker compose run --rm backend mvn ...
COPY --from=build /usr/share/maven /usr/share/maven
RUN ln -s /usr/share/maven/bin/mvn /usr/bin/mvn
COPY --from=build /opt/java/openjdk /opt/java/openjdk

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

COPY --from=build --chown=ellora:ellora /build /app
RUN mkdir -p /opt/ellora && cp /app/ellora-api/target/*.jar /opt/ellora/app.jar \
    && chown -R ellora:ellora /opt/ellora

USER ellora:ellora

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["java", "-jar", "/opt/ellora/app.jar"]
