# ==============================================================================
# Ellora Booking Backend - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to .env:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# 2. Generate a secure HMAC-SHA256 secret for JWT_SECRET:
#    powershell -ExecutionPolicy Bypass -File scripts/jwt-keys.ps1 (Windows)
#    bash scripts/jwt-keys.sh (Linux/macOS)
# 3. Supply required external credentials for Cloudinary and Google SMTP.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
# Active Spring Boot profile (local, staging, prod)
SPRING_PROFILES_ACTIVE=local
# Host port exposed by the backend container
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. PostgreSQL 17 Database Configuration (Local Docker Container)
# ------------------------------------------------------------------------------
# Database host: use 'postgres' inside docker network, 'localhost' from host machine
DB_HOST=localhost
# Host port mapped to PostgreSQL container (change if 5432 is in use locally)
DB_PORT=5432
DB_NAME=ellora
DB_USER=ellora
DB_PASSWORD=ellora_dev_secret

# ------------------------------------------------------------------------------
# 3. Redis 7 Configuration (Rate Limiting, Cache, Token Blacklist)
# ------------------------------------------------------------------------------
# Redis host: use 'redis' inside docker network, 'localhost' from host machine
REDIS_HOST=localhost
# Host port mapped to Redis container (change if 6379 is in use locally)
REDIS_PORT=6379
# Optional password for Redis (leave empty for local dev)
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Mail Service Configuration (Local Mailpit & Google SMTP)
# ------------------------------------------------------------------------------
# For local dev, Mailpit captures all outgoing emails without sending to real inboxes.
# Mailpit SMTP port (default: 1025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@ellora.vn
MAIL_FROM_NAME=Ellora Booking

# Required for real email delivery in staging/production via Google SMTP:
# Google Account email address (e.g., your-email@gmail.com)
MAIL_USERNAME=
# Google App Password (16-character token from myaccount.google.com/apppasswords)
MAIL_PASSWORD=

# Mailpit Web UI port (for viewing captured emails in browser at http://localhost:8025)
MAILPIT_UI_PORT=8025

# ------------------------------------------------------------------------------
# 5. JWT Authentication (HMAC-SHA256 / HS256)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret (>= 256 bits / 32 bytes base64 encoded).
# Generate using: scripts/jwt-keys.ps1 or scripts/jwt-keys.sh
JWT_SECRET=
# Token issuer identifier
JWT_ISSUER=ellora-booking-be
# Access token expiration in seconds (default: 900s = 15 minutes)
JWT_ACCESS_EXPIRATION_SECONDS=900
# Refresh token expiration in seconds (default: 604800s = 7 days)
JWT_REFRESH_EXPIRATION_SECONDS=604800

# ------------------------------------------------------------------------------
# 6. Cloudinary Image Storage (Required External Credentials)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 7. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Allowed origin for Vite frontend
FRONTEND_URL=http://localhost:5173
# Public base URL of backend API
API_BASE_URL=http://localhost:8080

# PayOS payment channel credentials from my.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Public URLs used by PayOS after payment or cancellation
PAYOS_RETURN_URL=http://localhost:5173/owner/subscription
PAYOS_CANCEL_URL=http://localhost:5173/owner/subscription

# Local HTTPS tunnel for PayOS webhooks
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

# ------------------------------------------------------------------------------
# 8. PGAdmin Web Console (Optional Tools Profile)
# ------------------------------------------------------------------------------
# Host port mapped to PGAdmin container (http://localhost:5050)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@ellora.vn
PGADMIN_DEFAULT_PASSWORD=admin

# ------------------------------------------------------------------------------
# 9. Google OAuth 2.0 Authentication
# ------------------------------------------------------------------------------
# Google Web Client ID for verifying Google ID Tokens (credential)
GOOGLE_CLIENT_ID=

