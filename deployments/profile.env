# Ellora Booking Backend — deployment profile.
#
# Non-secret values only. Parse with:
#   set -a; . deployments/profile.env; set +a
#
# Secrets live in /opt/ellora/.env.production on the VPS (mode 600) and in the
# GitHub Environment `production`. Never add a secret to this file.

APP_NAME=ellora
APP_OWNER=Eddie0517
REPO=github.com/Eddie0517/ellora-booking-be
SERVICES=api
STACK_api=java
ENVIRONMENTS=production

# --- production ---
PRODUCTION_DOMAIN=api.ellorabooking.online
PRODUCTION_PUBLIC_URL=https://api.ellorabooking.online
PRODUCTION_PATH=/opt/ellora
PRODUCTION_COMPOSE=deployments/docker-compose.yml
PRODUCTION_ENV_FILE=.env.production
PRODUCTION_DEPLOY_FILE=.env.production.deploy
PRODUCTION_TRIGGER=tag:v*
PRODUCTION_HEALTH_URL=https://api.ellorabooking.online/healthz

# --- exposure ---
# Cloudflare Tunnel: outbound-only, no host port, TLS terminated at the edge.
# Therefore HTTP_PORT / HTTPS_PORT are intentionally absent.
EXPOSURE_MODEL=cloudflare-tunnel
TLS_MODEL=cloudflare-edge
PROXY=

# --- data ---
DB_ENGINE=postgres
DB_VERSION=17
CACHE_ENGINE=redis
CACHE_VERSION=7
BACKUP_PATH=/opt/ellora-backups
BACKUP_KEEP_DAYS=7

# --- registry / CI ---
IMAGE_PREFIX=ghcr.io/eddie0517/ellora
SECRET_MODEL=github-env+vps-file
